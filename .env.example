# Copy to .env and fill in real values. .env is gitignored.
# Cloud LLM (OpenAI-compatible endpoint) used by orchestrator planning/design stages.
OPENAI_API_KEY=sk-your-key-here
CLOUD_BASE_URL=http://localhost:20128/v1
CLOUD_MODEL=My-combo

# Route Planning to local Ollama (smallest model that works); unset to use the cloud proxy.
PLANNING_MODEL=qwen2.5:3b
