{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "code_output.schema.json",
  "title": "CodeOutput",
  "description": "Output of a Backend or Frontend specialist stage. A simple, direct contract - no tool-calling protocol, just structured output.",
  "type": "object",
  "required": ["stage", "spec_version", "files"],
  "properties": {
    "stage": { "type": "string", "enum": ["backend", "frontend"] },
    "spec_version": { "type": "integer" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "description": "Relative file path, e.g. 'main.py'" },
          "content": { "type": "string", "description": "Full file content" }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Optional free-text notes from the specialist (not parsed, just logged)."
    }
  }
}
